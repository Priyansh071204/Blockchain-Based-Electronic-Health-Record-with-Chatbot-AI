NODE_ENV=development
PORT=4000
MOCK_FABRIC=true
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
IPFS_PROTOCOL=http
IPFS_HOST=localhost
IPFS_PORT=5001
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=ehr-chaincode

# Optional: enables natural LLM chatbot answers. Without this, the app uses local fallback answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
